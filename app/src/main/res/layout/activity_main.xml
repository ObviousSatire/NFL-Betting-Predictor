<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="#1a1a2e">

    <TextView
        android:id="@+id/scoreBanner"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:background="#16213e"
        android:textColor="#FFD700"
        android:textSize="13sp"
        android:gravity="center_vertical"
        android:singleLine="true"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="Loading scores..." />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <Spinner
            android:id="@+id/teamSpinner"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/spinner_background"
            android:padding="8dp" />

        <Spinner
            android:id="@+id/playerSpinner"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/spinner_background"
            android:padding="8dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/loadingIndicator"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="center"
        android:layout_marginTop="4dp"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:background="#16213e"
        android:padding="8dp">

        <TextView
            android:id="@+id/resultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select a team to begin..."
            android:textColor="#E0E0E0"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/testButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="TEST"
            android:textSize="11sp"
            android:backgroundTint="#0f3460" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/loadStatsButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="STATS"
            android:textSize="11sp"
            android:layout_marginStart="4dp"
            android:backgroundTint="#0f3460" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/loadPlayerButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="PLAYER"
            android:textSize="11sp"
            android:layout_marginStart="4dp"
            android:backgroundTint="#0f3460" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/predictButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="PREDICT"
            android:textSize="11sp"
            android:backgroundTint="#0f3460" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/refreshAllButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="REFRESH"
            android:textSize="11sp"
            android:layout_marginStart="4dp"
            android:backgroundTint="#0f3460" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/clearButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="CLEAR"
            android:textSize="11sp"
            android:layout_marginStart="4dp"
            android:backgroundTint="#0f3460" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/helpButton"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="HELP (Long Press for Settings)"
            android:textSize="11sp"
            android:backgroundTint="#e94560" />
    </LinearLayout>

</LinearLayout>
